+/// Resolves the `dns_forward_servers` flag into hickory name server configs.
+/// Entries that fail to parse or resolve are skipped with a warning, so one
+/// bad entry cannot take down the whole forwarder. Hostnames are resolved
+/// once here via the system resolver and the resulting address is pinned;
+/// TLS names are kept for certificate validation.
+async fn resolve_dns_forward_servers(urls: Vec<String>) -> Vec<NameServerConfig> {
+    let mut ret = Vec::new();
+    for raw in urls {
+        if raw.trim().is_empty() {
+            continue;
+        }
+        match parse_dns_forward_server(raw.trim()).await {
+            Ok(config) => ret.push(config),
+            Err(error) => {
+                tracing::warn!(url = %raw, ?error, "invalid dns_forward_servers entry, skipped");
+            }
+        }
+    }
+    if !ret.is_empty() {
+        tracing::info!(servers = ?ret, "using explicitly configured dns forward servers");
+    }
+    ret
+}
+
+async fn parse_dns_forward_server(raw: &str) -> anyhow::Result<NameServerConfig> {
+    use hickory_proto::xfer::Protocol;
+
+    let parsed = url::Url::parse(raw)?;
+    let protocol = match parsed.scheme().to_ascii_lowercase().as_str() {
+        "udp" => Protocol::Udp,
+        "tcp" => Protocol::Tcp,
+        "tls" => Protocol::Tls,
+        "https" => Protocol::Https,
+        other => anyhow::bail!("unsupported scheme {}, expect udp/tcp/tls/https", other),
+    };
+    let host = parsed
+        .host_str()
+        .context("missing server host")
+        .map(str::to_owned)?;
+    let default_port = match protocol {
+        Protocol::Udp | Protocol::Tcp => 53,
+        Protocol::Tls => 853,
+        _ => 443,
+    };
+    let port = parsed.port().unwrap_or(default_port);
+
+    // Pin the address once at startup: hickory does not bootstrap hostnames
+    // for forwarder entries on its own. Literal IPs skip the lookup.
+    let socket_addr = tokio::net::lookup_host((host.as_str(), port))
+        .await
+        .with_context(|| format!("failed to resolve dns forward server host {host}"))?
+        .next()
+        .with_context(|| format!("no address found for dns forward server host {host}"))?;
+
+    let mut config = NameServerConfig::new(socket_addr, protocol);
+    if matches!(protocol, Protocol::Tls | Protocol::Https) {
+        config.tls_dns_name = Some(host);
+    }
+    if protocol == Protocol::Https {
+        let path = parsed.path();
+        if !path.is_empty() && path != "/" {
+            config.http_endpoint = Some(path.to_string());
+        }
+    }
+    Ok(config)
+}
