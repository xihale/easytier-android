+/// Resolves the `dns_forward_servers` flag into hickory name server configs.
+/// Entries that fail to parse or resolve are skipped with a warning, so one
+/// bad entry cannot take down the whole forwarder. Well-known public DoT/DoH
+/// providers expand via built-in bootstrap IPs (immune to offline boot races
+/// and active-TUN self-lookup loops); custom hostnames expand to all resolved
+/// addresses (IPv4 first, then IPv6) under a bounded timeout.
+async fn resolve_dns_forward_servers(urls: Vec<String>) -> Vec<NameServerConfig> {
+    let mut ret = Vec::new();
+    for raw in urls {
+        if raw.trim().is_empty() {
+            continue;
+        }
+        match parse_dns_forward_server(raw.trim()).await {
+            Ok(configs) => ret.extend(configs),
+            Err(error) => {
+                tracing::warn!(url = %raw, ?error, "invalid dns_forward_servers entry, skipped");
+            }
+        }
+    }
+    if !ret.is_empty() {
+        tracing::info!(count = ret.len(), "using explicitly configured dns forward servers");
+    }
+    ret
+}
+
+fn bootstrap_dns_ips(host: &str) -> &'static [&'static str] {
+    match host.to_ascii_lowercase().as_str() {
+        "dns.alidns.com" => &[
+            "223.5.5.5",
+            "223.6.6.6",
+            "2400:3200::1",
+            "2400:3200:baba::1",
+        ],
+        "doh.pub" | "dot.pub" => &["1.12.12.12", "120.53.53.53"],
+        "doh.360.cn" | "dot.360.cn" => &["101.226.4.6", "218.30.118.6"],
+        "dns.google" => &[
+            "8.8.8.8",
+            "8.8.4.4",
+            "2001:4860:4860::8888",
+            "2001:4860:4860::8844",
+        ],
+        "cloudflare-dns.com" | "one.one.one.one" | "1dot1dot1dot1.cloudflare-dns.com" => &[
+            "1.1.1.1",
+            "1.0.0.1",
+            "2606:4700:4700::1111",
+            "2606:4700:4700::1001",
+        ],
+        "dns.quad9.net" => &["9.9.9.9", "149.112.112.112", "2620:fe::fe"],
+        _ => &[],
+    }
+}
+
+async fn parse_dns_forward_server(raw: &str) -> anyhow::Result<Vec<NameServerConfig>> {
+    use hickory_proto::xfer::Protocol;
+    use std::net::{IpAddr, SocketAddr};
+
+    let parsed = url::Url::parse(raw)?;
+    let protocol = match parsed.scheme().to_ascii_lowercase().as_str() {
+        "udp" => Protocol::Udp,
+        "tcp" => Protocol::Tcp,
+        "tls" => Protocol::Tls,
+        "https" => Protocol::Https,
+        other => anyhow::bail!("unsupported scheme {}, expect udp/tcp/tls/https", other),
+    };
+    let raw_host = parsed.host_str().context("missing server host")?;
+    let host = raw_host
+        .strip_prefix('[')
+        .and_then(|s| s.strip_suffix(']'))
+        .unwrap_or(raw_host)
+        .to_owned();
+    let default_port = match protocol {
+        Protocol::Udp | Protocol::Tcp => 53,
+        Protocol::Tls => 853,
+        _ => 443,
+    };
+    let port = parsed.port().unwrap_or(default_port);
+
+    let mut addrs: Vec<SocketAddr> = if let Ok(ip) = host.parse::<IpAddr>() {
+        vec![SocketAddr::new(ip, port)]
+    } else {
+        let bootstrap = bootstrap_dns_ips(&host);
+        if !bootstrap.is_empty() {
+            bootstrap
+                .iter()
+                .filter_map(|s| s.parse::<IpAddr>().ok().map(|ip| SocketAddr::new(ip, port)))
+                .collect()
+        } else {
+            tokio::time::timeout(
+                std::time::Duration::from_secs(3),
+                tokio::net::lookup_host((host.as_str(), port)),
+            )
+            .await
+            .with_context(|| format!("dns lookup timed out for forward server host {host}"))?
+            .with_context(|| format!("failed to resolve dns forward server host {host}"))?
+            .collect()
+        }
+    };
+    addrs.sort_by_key(|a| if a.is_ipv4() { 0u8 } else { 1u8 });
+    addrs.dedup();
+    anyhow::ensure!(
+        !addrs.is_empty(),
+        "no address found for dns forward server host {host}"
+    );
+
+    let tls_name = matches!(protocol, Protocol::Tls | Protocol::Https).then_some(host);
+    let http_endpoint = (protocol == Protocol::Https)
+        .then(|| parsed.path())
+        .filter(|p| !p.is_empty() && *p != "/")
+        .map(str::to_owned);
+
+    Ok(addrs
+        .into_iter()
+        .map(|socket_addr| {
+            let mut config = NameServerConfig::new(socket_addr, protocol);
+            config.tls_dns_name = tls_name.clone();
+            config.http_endpoint = http_endpoint.clone();
+            config
+        })
+        .collect())
+}
