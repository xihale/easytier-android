    <!-- Clash integration help -->
    <string name="clash_help_title">Clash integration</string>
    <string name="clash_help_section_import">Routing override</string>
    <string name="clash_help_import_intro">Paste into Clash override (before MATCH) to route virtual subnets and Magic DNS to local SOCKS5:</string>
    <string name="clash_help_intro_note">IP rules come from routes of running instances — start a network first to obtain its route IPs before IP-CIDR rules can be generated; until then the snippet contains only the SOCKS5 proxy declaration.</string>
    <string name="clash_help_copied_snippet">Routing snippet copied</string>
    <string name="clash_help_socks5_off_hint">SOCKS5 listener is off — enable it in Settings → SOCKS5 first so the snippet port matches the actual listener.</string>
    <string name="clash_help_no_cidr_hint">No virtual subnets detected — start a network or configure a virtual IP / proxied subnets for one, and this snippet updates live.</string>
