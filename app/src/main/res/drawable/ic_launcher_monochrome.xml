<?xml version="1.0" encoding="utf-8"?>
<!-- Android 13+ Material You 单色主题图标（支持系统壁纸自动动态取色） -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">
    <!-- 与前景字形保持同一缩放比例 -->
    <group
        android:pivotX="512"
        android:pivotY="512"
        android:scaleX="1.1"
        android:scaleY="1.1">
        <!-- 中心圆点 -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M512,512m-100,0a100,100 0,1 1,200 0a100,100 0,1 1,-200 0" />
        <!-- 外围弧线 1 -->
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="80"
            android:strokeLineCap="round"
            android:pathData="M512,280 A232,232 0 0,1 713,396" />
        <!-- 外围弧线 2 -->
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="80"
            android:strokeLineCap="round"
            android:pathData="M311,628 A232,232 0 0,1 311,396" />
        <!-- 外围弧线 3 -->
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="80"
            android:strokeLineCap="round"
            android:pathData="M713,628 A232,232 0 0,1 512,744" />
    </group>
</vector>
