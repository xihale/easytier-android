<?xml version="1.0" encoding="utf-8"?>
<!-- 快捷设置磁贴图标：与应用图标同构（中心圆点 + 外围弧线），取单色几何供系统着色 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="544"
    android:viewportHeight="544">
    <group
        android:translateX="-240"
        android:translateY="-240">
        <!-- 中心圆点 -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M512,512m-100,0a100,100 0,1 1,200 0a100,100 0,1 1,-200 0" />
        <!-- 外围弧线 1 -->
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="80"
            android:strokeLineCap="round"
            android:pathData="M512,280 A232,232 0 0,1 713,396" />
        <!-- 外围弧线 2 -->
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="80"
            android:strokeLineCap="round"
            android:pathData="M311,628 A232,232 0 0,1 311,396" />
        <!-- 外围弧线 3 -->
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="80"
            android:strokeLineCap="round"
            android:pathData="M713,628 A232,232 0 0,1 512,744" />
    </group>
</vector>
